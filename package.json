{
  "name": "team-gammon",
  "version": "0.1.0",
  "description": "4-player team backgammon (Plakoto-style pins): rules engine, bots, server and web client",
  "private": true,
  "type": "module",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "node server/index.js",
    "dev": "node --watch server/index.js",
    "test": "node --test",
    "test:py": "python -m unittest discover -s train/tests -t .",
    "e2e": "node e2e/run.mjs",
    "sim": "node tools/sim.mjs",
    "arena": "node tools/arena.mjs",
    "explore": "node tools/explore.mjs",
    "safety": "node tools/safety.mjs"
  },
  "dependencies": {
    "better-sqlite3": "^13.0.3",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.1",
    "express-session": "^1.19.0",
    "helmet": "^8.3.0",
    "socket.io": "^4.8.4"
  },
  "devDependencies": {
    "playwright-core": "^1.64.1",
    "socket.io-client": "^4.8.4"
  }
}
